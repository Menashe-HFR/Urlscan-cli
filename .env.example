# The default demo provider makes no external requests and needs no key.
URLSCAN_PROVIDER=demo
URLSCAN_DATABASE=studio.db
# Set only for live urlscan.io mode. Never put a real key in source control.
URLSCAN_API_KEY=
URLSCAN_CONCURRENCY=3
URLSCAN_CACHE_TTL=3600

# Optional: larger screenshot allowance; never expose this value in the browser.
MICROLINK_API_KEY=
